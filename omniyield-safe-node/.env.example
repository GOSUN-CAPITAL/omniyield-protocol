# OmniSafe Sovereign Node Environment Variables
PORT=4000
NODE_ENV=production
OMNISAFE_JWT_SECRET=super_secret_jwt_entropy_key_change_in_production
FRONTEND_ORIGIN=https://app.omniyield.finance
NEAR_NETWORK=testnet

# Google Gemini AI Studio Key (Live Autonomous Reasoning Engine)
GEMINI_API_KEY=your_gemini_api_key_here
